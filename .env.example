# ============================================================
# Cortex MCP Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ─── Required: Cortex API credentials ───────────────────────
# Standard API key (the secret)
CORTEX_MCP_PAPI_AUTH_HEADER=your_api_key_secret_here

# Numeric ID associated with the API key
CORTEX_MCP_PAPI_AUTH_ID=12345

# standard (default) sends the raw key. advanced sends SHA256(key + nonce + timestamp)
# on every request and never sends the raw key.
# CORTEX_MCP_PAPI_KEY_TYPE=standard

# Base URL of your Cortex tenant (no trailing slash)
CORTEX_MCP_PAPI_URL=https://api-your-tenant.xdr.us.paloaltonetworks.com

# ─── Optional: Transport ────────────────────────────────────
# stdio (default) | streamable-http
# http is an alias of streamable-http. sse is rejected.
MCP_TRANSPORT=stdio

# Only relevant when MCP_TRANSPORT=streamable-http.
# The code default is 127.0.0.1. The Docker image sets MCP_HOST=0.0.0.0
# so a published port works. Do not set 127.0.0.1 in a container env file.
# MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp

# Comma-separated. The code default is 127.0.0.1,localhost,::1.
# The Docker image sets MCP_ALLOWED_HOSTS=* for a published port.
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# Comma-separated browser origins. A missing Origin is allowed.
# MCP_ALLOWED_ORIGINS=https://chat.example.com

# Bearer token clients must send (Authorization: Bearer <token>) when
# MCP_TRANSPORT=streamable-http. Leave unset for local stdio use. Strongly
# recommended for any deployment reachable over a network (e.g. Fly.io) —
# without it, anyone who finds the URL can call your Cortex tools.
# MCP_AUTH_TOKEN=

# ─── Optional: Feature flags ────────────────────────────────
# When false, tools that change tenant or Broker VM appliance state are not registered.
# Read-only tools stay available. Action, write, and secret tools stay hidden.
# Descriptions state the side effect from the operation's x-cortex-mcp-side-effect class.
MCP_WRITE_TOOLS_ENABLED=false

# When false, tools that return secrets or credential-like artifacts are not registered.
# Also requires MCP_WRITE_TOOLS_ENABLED=true. This covers private-key export, the XSOAR
# credential vault, engine configuration downloads, and signed installer URLs.
MCP_SECRET_TOOLS_ENABLED=false

# When false, isolate_endpoint and unisolate_endpoint are not registered.
MCP_ISOLATE_ENDPOINT_TOOL_ENABLED=false

# When true, a mutating tool asks for confirmation through MCP elicitation before it runs.
# When false, registered tools run without that prompt. Write and isolate flags still control registration.
MCP_ELICITATION_ENABLED=false

# When true, repeat formatting guidance inside every tool result.
# When false, that guidance is sent once in the MCP initialize instructions.
# MCP_INLINE_FORMATTING_INSTRUCTIONS=false

# ─── Optional: On-appliance Broker VM ───────────────────────
# Hostname or https URL of the broker appliance. Not the tenant API URL.
# Leave unset unless you call the 10 on-appliance broker tools.
# CORTEX_MCP_BROKER_URL=https://broker.example.local
#
# Factory or current admin password. Stays on this server. It is exchanged for a
# 10-minute broker bearer and is not sent to Cortex or to the MCP client.
# After reset-initial-password, set this to the new password before the next restart.
# CORTEX_MCP_BROKER_FACTORY_PASSWORD=

# ─── Optional: Logging ──────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_ENABLE_UVICORN_ACCESS_LOGS=true

# ─── Optional: Limits ───────────────────────────────────────
MAX_OBJECTS_TO_RETRIEVE=50
CORTEX_MCP_RESPONSE_ERROR_MAX_SIZE=1000

# Extra attempts after the first request for connection errors, timeouts, and HTTP 429/503.
# Read timeouts on report and search endpoints are not retried.
# CORTEX_MCP_MAX_RETRIES=3

# Per-attempt timeout, in seconds, for a Cortex HTTP call.
# CORTEX_MCP_TIMEOUT_S=20

# Wall-clock budget for one tools/call, including retries and backoff.
# The default is under the MCP client's usual 60s request timeout.
# CORTEX_MCP_CALL_DEADLINE_S=45

# Not read by cortex-mcp. Set this on the MCP gateway or client (Prisma AIRS /
# Portkey, or the TypeScript MCP SDK). The SDK default is 60000. Keep it above
# CORTEX_MCP_CALL_DEADLINE_S converted to milliseconds so a slow Cortex call
# returns an isError tool result instead of JSON-RPC -32001.
# MCP_REQUEST_TIMEOUT_MS=60000

# Process-wide limit on tools/call. tools/list is not counted.
# MCP_TOOL_CALLS_PER_SECOND=10
# MCP_TOOL_CALL_BURST=20

# ─── Optional: Update ───────────────────────────────────────
# Path to the folder that the 'update' CLI command will refresh
# CORTEX_MCP_UPDATE_FOLDER=src/usecase/remote_components
