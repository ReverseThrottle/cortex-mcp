# ============================================================
# Cortex MCP Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ─── Required: Cortex API credentials ───────────────────────
# Standard API key (the secret)
CORTEX_MCP_PAPI_AUTH_HEADER=your_api_key_secret_here

# Numeric ID associated with the API key
CORTEX_MCP_PAPI_AUTH_ID=12345

# Base URL of your Cortex tenant (no trailing slash)
CORTEX_MCP_PAPI_URL=https://api-your-tenant.xdr.us.paloaltonetworks.com

# ─── Optional: Transport ────────────────────────────────────
# stdio (default) | streamable-http
MCP_TRANSPORT=stdio

# Only relevant when MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp

# ─── Optional: Feature flags ────────────────────────────────
# These are tiered by blast radius rather than one blanket switch — enabling
# low-risk writes does not enable script execution or file quarantine.

# Enable low/moderate-risk write tools (update_case, detection-content CRUD,
# compliance authoring, etc.)
MCP_WRITE_TOOLS_ENABLED=false

# Enable endpoint isolation / unisolation tools
MCP_ISOLATE_ENDPOINT_TOOL_ENABLED=false

# Enable endpoint fleet administration (delete endpoints, agent upgrades, tags,
# distributions, legacy exception / prevention profile CRUD)
MCP_ENDPOINT_ADMIN_TOOLS_ENABLED=false

# Enable endpoint response actions (scan, cancel scan, forensics triage, retrieve file)
MCP_ENDPOINT_ACTION_TOOLS_ENABLED=false

# Enable file actions (quarantine, restore, block-list, allow-list)
MCP_FILE_ACTION_TOOLS_ENABLED=false

# Enable remote script execution on endpoints — highest blast radius in the API
MCP_SCRIPT_EXEC_TOOLS_ENABLED=false

# Enable vulnerability/network scan triggers (vuln policy scans, NetScan)
MCP_VULN_SCAN_TOOLS_ENABLED=false

# Enable MCP elicitation support (used to confirm high-risk actions, e.g. script execution)
MCP_ELICITATION_ENABLED=false

# ─── Optional: Logging ──────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_ENABLE_UVICORN_ACCESS_LOGS=true

# ─── Optional: Limits ───────────────────────────────────────
MAX_OBJECTS_TO_RETRIEVE=50
CORTEX_MCP_RESPONSE_ERROR_MAX_SIZE=1000

# ─── Optional: Update ───────────────────────────────────────
# Path to the folder that the 'update' CLI command will refresh
# CORTEX_MCP_UPDATE_FOLDER=src/usecase/remote_components
