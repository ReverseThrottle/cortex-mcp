# ============================================================
# Cortex MCP Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ─── Required: Cortex API credentials ───────────────────────
# Standard API key (the secret)
CORTEX_MCP_PAPI_AUTH_HEADER=your_api_key_secret_here

# Numeric ID associated with the API key
CORTEX_MCP_PAPI_AUTH_ID=12345

# Base URL of your Cortex tenant (no trailing slash)
CORTEX_MCP_PAPI_URL=https://api-your-tenant.xdr.us.paloaltonetworks.com

# ─── Optional: Transport ────────────────────────────────────
# stdio (default) | streamable-http
MCP_TRANSPORT=stdio

# Only relevant when MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp

# Bearer token clients must send (Authorization: Bearer <token>) when
# MCP_TRANSPORT=streamable-http. Leave unset for local stdio use. Strongly
# recommended for any deployment reachable over a network (e.g. Fly.io) —
# without it, anyone who finds the URL can call your Cortex tools.
# MCP_AUTH_TOKEN=

# ─── Optional: Feature flags ────────────────────────────────
# When false, tools that change tenant or Broker VM appliance state are not registered.
# Read-only tools stay available. Descriptions still state side effects when writes are enabled.
MCP_WRITE_TOOLS_ENABLED=false

# When false, isolate_endpoint and unisolate_endpoint are not registered.
MCP_ISOLATE_ENDPOINT_TOOL_ENABLED=false

# When true, a mutating tool asks for confirmation through MCP elicitation before it runs.
# When false, registered tools run without that prompt. Write and isolate flags still control registration.
MCP_ELICITATION_ENABLED=false

# ─── Optional: On-appliance Broker VM ───────────────────────
# Hostname or https URL of the broker appliance. Not the tenant API URL.
# Leave unset unless you call the 10 on-appliance broker tools.
# CORTEX_MCP_BROKER_URL=https://broker.example.local
#
# Factory or current admin password. Stays on this server. It is exchanged for a
# 10-minute broker bearer and is not sent to Cortex or to the MCP client.
# After reset-initial-password, set this to the new password before the next restart.
# CORTEX_MCP_BROKER_FACTORY_PASSWORD=

# ─── Optional: Logging ──────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_ENABLE_UVICORN_ACCESS_LOGS=true

# ─── Optional: Limits ───────────────────────────────────────
MAX_OBJECTS_TO_RETRIEVE=50
CORTEX_MCP_RESPONSE_ERROR_MAX_SIZE=1000

# Extra attempts after the first request for connection errors and HTTP 429/503.
# CORTEX_MCP_MAX_RETRIES=3

# ─── Optional: Update ───────────────────────────────────────
# Path to the folder that the 'update' CLI command will refresh
# CORTEX_MCP_UPDATE_FOLDER=src/usecase/remote_components
